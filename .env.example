# Server Configuration
PORT=3000
NODE_ENV=development

# Kafka Configuration
KAFKA_BROKER=localhost:9092
KAFKA_CLIENT_ID=streamguard-client
KAFKA_TOPIC=location
KAFKA_GROUP_ID=streamguard-group
KAFKA_CONNECTION_TIMEOUT=10000
KAFKA_REQUEST_TIMEOUT=30000

# MongoDB Configuration
MONGO_URL=mongodb://localhost:27017/streamguard
MONGO_CONNECTION_TIMEOUT=10000
MONGO_SOCKET_TIMEOUT=45000

# Consumer Configuration
MAX_DATA_LENGTH_BUFFER=100
CONSUMER_FLUSH_INTERVAL_MS=5000
CONSUMER_INSERT_MAX_RETRIES=3
CONSUMER_INITIAL_RETRY_DELAY_MS=1000
CONSUMER_SESSION_TIMEOUT=30000

# Logging Configuration
LOG_LEVEL=info
LOG_FORMAT=json

# Metrics Configuration
METRICS_ENABLED=true
METRICS_PORT=9090
